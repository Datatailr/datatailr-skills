{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "datatailr-skills",
  "version": "0.2.1",
  "description": "Build & deploy with Datatailr",
  "author": {
    "name": "Datatailr",
    "url": "https://www.datatailr.com/"
  },
  "homepage": "https://www.datatailr.com/",
  "repository": "https://github.com/Datatailr/datatailr-skills",
  "license": "MIT",
  "keywords": [
    "datatailr",
    "data",
    "workflows",
    "deployment"
  ],
  "extensions": {
    "com.openai": {
      "requires_local_executor": true,
      "interface": {
        "displayName": "Datatailr Skills",
        "shortDescription": "Build & deploy with Datatailr",
        "longDescription": "Skills for Datatailr workflows, services, web apps, Excel add-ins, storage, administration, and observability. Requires an existing Datatailr environment and the appropriate SDK, CLI, and permissions.",
        "developerName": "Datatailr",
        "category": "Developer Tools",
        "websiteURL": "https://www.datatailr.com/",
        "supportURL": "https://datatailr.com/contact",
        "privacyPolicyURL": "https://datatailr.com/privacy-policy",
        "logo": "./.claude-plugin/icon.png",
        "composerIcon": "./.claude-plugin/icon.png",
        "defaultPrompt": [
          "Deploy a data processing workflow to my Datatailr development environment.",
          "Build a dashboard using my Datatailr environment.",
          "Help me investigate a failed Datatailr job."
        ]
      }
    }
  }
}
